{
  "name": "fabplane-cli",
  "version": "0.1.0",
  "description": "Typed API client, CLI (`fabplane`) and stdio MCP server for fabplane.com, plus a client for the local fabdesk desktop daemon.",
  "license": "MIT",
  "type": "module",
  "author": "fabPlane",
  "homepage": "https://fabplane.com/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabPlane/fabplane-cli.git"
  },
  "bugs": {
    "url": "https://github.com/fabPlane/fabplane-cli/issues"
  },
  "keywords": ["fabplane", "pcb", "bom", "inventory", "mcp", "cli", "kicad"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "fabplane": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "spec"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "rm -rf build-test && tsc -p tsconfig.test.json",
    "test": "node --test --test-reporter=spec build-test/test/*.test.js",
    "sync-spec": "node --experimental-strip-types scripts/sync-spec.ts",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~5.9.2",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  }
}
